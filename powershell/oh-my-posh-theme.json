{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "shell_integration": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "session",
          "style": "plain",
          "foreground": "#00d7ff",
          "template": "{{ .UserName }}"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#afafaf",
          "template": "@"
        },
        {
          "type": "session",
          "style": "plain",
          "foreground": "#5f87ff",
          "template": "{{ .HostName }}"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#afafaf",
          "template": ":"
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "#d7d787",
          "options": {
            "style": "full"
          },
          "template": "{{ .Path }}"
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#5fff87",
          "template": " ({{ .HEAD }}{{ if .Working.Changed }} *{{ end }})"
        },
        {
          "type": "text",
          "style": "plain",
          "template": " "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "newline": false,
      "filler": "─",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "template": " "
        },
        {
          "type": "time",
          "style": "plain",
          "foreground": "#ffff00",
          "options": {
            "time_format": "2006-01-02T15:04:05"
          },
          "template": "{{ .CurrentDate | date .Format }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#ff5f00",
          "template": "$ "
        }
      ]
    }
  ]
}
